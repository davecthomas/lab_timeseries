# AI commentary settings, read by ai-api-unified.
# Copy to .env and fill in the key. .env is gitignored.

# Anthropic (native Claude API) key — required for the "Analysis with AI" button.
ANTHROPIC_API_KEY=

# Provider selection. Claude is the only engine this app supports right now.
COMPLETIONS_ENGINE=claude

# Optional model override. Leave unset to use the library default (claude-opus-4-8).
# COMPLETIONS_MODEL_NAME=claude-opus-4-8

# Optional geo-residency constraint (US | USA | United States).
# AI_API_GEO_RESIDENCY=
